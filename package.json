{
  "name": "petlink-everywhere-test",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prettier:write-src": "prettier --write --ignore-path .prettierignore ./src",
    "precommit": "yarn prettier:write-src && yarn run tsc --noEmit",
    "fetch:schemas": "node --loader ts-node/esm src/clients/petlink-infrastructure/endpoints/graphql/scripts/fetch-schema.ts ALL",
    "codegen:generate-sdk": "graphql-codegen --config codegen.yaml",
    "fetch-schemas:generate-sdk": "fetch:schemas && codegen:generate-sdk",
    "test": "vitest run",
    "pipeline": "yarn fetch:schemas && yarn codegen:generate-sdk && yarn test",
    "pipeline:develop": "NODE_ENV=develop yarn pipeline",
    "pipeline:test": "NODE_ENV=test yarn pipeline"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.6",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@types/node": "20.14.2",
    "@types/twilio": "^3.19.3",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^17.2.2",
    "get-graphql-schema": "^2.1.2",
    "graphql": "^16.9.0",
    "graphql-request": "^6.1.0",
    "prettier": "^3.3.2",
    "typescript": "~5.4.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.891.0",
    "@aws-sdk/credential-provider-node": "^3.662.0",
    "@aws-sdk/protocol-http": "^3.374.0",
    "@aws-sdk/signature-v4": "^3.374.0",
    "googleapis": "^160.0.0",
    "ts-node": "^10.9.2",
    "twilio": "^5.9.0",
    "zod": "^4.1.11"
  }
}
