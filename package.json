{
  "name": "petlink-everywhere-test",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "fetch:cct-schema": "node --loader ts-node/esm scripts/fetchCctSchema.ts",
    "fetch:core-schema": "node --loader ts-node/esm scripts/fetchCoreSchema.ts",
    "codegen": "graphql-codegen --config codegen.yaml",
    "prettier:write-src": "prettier --write ./src",
    "precommit": "yarn prettier:write-src && yarn fetch:cct-schema && yarn fetch:core-schema && yarn run tsc --noEmit"
  }
,
  "devDependencies": {
    "@types/node": "20.14.2",
    "dotenv": "^17.2.2",
    "vitest": "^1.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "prettier": "^3.3.2",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.6",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "get-graphql-schema": "^2.1.2",
    "graphql": "^16.9.0",
    "graphql-request": "^6.1.0"
  }
}

