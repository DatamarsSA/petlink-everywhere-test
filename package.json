{
  "name": "petlink-everywhere-test",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fetch:schema": "node --loader ts-node/esm scripts/fetchSchema.ts",
    "fetch:cct-schema:develop": "NODE_ENV=develop yarn fetch:schema CCT",
    "fetch:cct-schema:test": "NODE_ENV=test yarn fetch:schema CCT",
    "fetch:core-schema:develop": "NODE_ENV=develop yarn fetch:schema CORE",
    "fetch:core-schema:test": "NODE_ENV=test yarn fetch:schema CORE",
    "fetch:all-schemas:develop": "yarn fetch:cct-schema:develop && yarn fetch:core-schema:develop",
    "fetch:all-schemas:test": "yarn fetch:cct-schema:test && yarn fetch:core-schema:test",
    "test:develop": "vitest --mode develop",
    "test:test": "vitest --mode test",
    "test:develop:run": "vitest run --mode develop",
    "test:test:run": "vitest run --mode test",
    "run:develop": "yarn fetch:all-schemas:develop && yarn test:develop:run",
    "run:test": "yarn fetch:all-schemas:test && yarn test:test:run",
    "codegen": "graphql-codegen --config codegen.yaml",
    "prettier:write-src": "prettier --write ./src",
    "precommit": "yarn prettier:write-src && yarn run tsc --noEmit"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.6",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@types/node": "20.14.2",
    "dotenv": "^17.2.2",
    "get-graphql-schema": "^2.1.2",
    "graphql": "^16.9.0",
    "graphql-request": "^6.1.0",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "vitest": "^1.1.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.891.0",
    "@aws-sdk/credential-provider-node": "^3.662.0",
    "@aws-sdk/protocol-http": "^3.374.0",
    "@aws-sdk/signature-v4": "^3.374.0",
    "zod": "^4.1.11"
  }
}
